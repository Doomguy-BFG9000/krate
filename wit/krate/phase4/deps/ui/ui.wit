package krate:ui@0.1.0;

/// Shared records and errors for Phase 3 UI calls.
interface types {
  /// Window state requested by an app or reported by the host.
  enum window-state {
    /// Normal restored window.
    normal,
    /// Minimized window.
    minimized,
    /// Maximized window.
    maximized,
    /// Borderless fullscreen window.
    fullscreen,
  }

  /// Logical window size in device-independent pixels.
  record window-size {
    /// Width in logical pixels.
    width: u32,
    /// Height in logical pixels.
    height: u32,
  }

  /// Rectangle in logical pixels.
  record rect {
    /// Left edge.
    x: f32,
    /// Top edge.
    y: f32,
    /// Width.
    width: f32,
    /// Height.
    height: f32,
  }

  /// Current host color preference.
  enum theme {
    /// Light system appearance.
    light,
    /// Dark system appearance.
    dark,
    /// Host did not report a stable preference.
    unknown,
  }

  /// Mouse or touch button.
  enum pointer-button {
    /// Primary button.
    primary,
    /// Secondary button.
    secondary,
    /// Middle button.
    middle,
    /// Host-specific extra button.
    other,
  }

  /// Keyboard modifier state.
  record modifiers {
    /// Shift key is down.
    shift: bool,
    /// Control key is down.
    control: bool,
    /// Alt or Option key is down.
    alt: bool,
    /// Command key on macOS or Windows key on Windows.
    meta: bool,
  }

  /// Pointer input event delivered by the host.
  record pointer-event {
    /// Target window id.
    window: u64,
    /// Target widget id if hit testing found one.
    widget: option<u64>,
    /// X position in logical pixels.
    x: f32,
    /// Y position in logical pixels.
    y: f32,
    /// Button that changed, when a button changed.
    button: option<pointer-button>,
    /// True when this is a press, false when it is a release.
    pressed: bool,
    /// Modifier state at the time of the event.
    modifiers: modifiers,
  }

  /// A wheel, trackpad, or scroll-gesture event delivered by the host.
  ///
  /// Shaped like `pointer-event` on purpose: an app scrolls the thing under the
  /// cursor, so it needs the same position and the same hit-tested widget, and
  /// an author who has already written pointer handling can write this one
  /// without learning a second shape.
  ///
  /// Deltas are in **logical pixels**, not lines or notches. Every windowing
  /// system reports one or the other -- a macOS trackpad gives pixel-precise
  /// deltas, a mouse wheel gives discrete notches -- and asking every app to
  /// know which it got means every app gets it wrong on one platform. The host
  /// converts: a notch becomes about 20 logical pixels, matching what native
  /// applications move for one click of a wheel. An app can add the delta to a
  /// scroll offset and clamp it, and that works the same on all three systems.
  ///
  /// Positive `dy` scrolls the content *down*, meaning the view moves further
  /// into a long list, which is the direction a scroll offset grows. Positive
  /// `dx` scrolls right. This already accounts for the platform's natural
  /// scrolling setting, so an app never reads a preference to know which way is
  /// which.
  record wheel-event {
    /// Target window id.
    window: u64,
    /// Target widget id if hit testing found one.
    widget: option<u64>,
    /// Cursor X in logical pixels when the wheel moved.
    x: f32,
    /// Cursor Y in logical pixels when the wheel moved.
    y: f32,
    /// Horizontal delta in logical pixels. Positive scrolls right.
    dx: f32,
    /// Vertical delta in logical pixels. Positive scrolls down.
    dy: f32,
    /// Modifier state at the time of the event.
    ///
    /// Worth checking: ctrl-scroll means zoom on every desktop, so an app that
    /// scrolls on this without looking will zoom nothing and scroll when the
    /// person asked to zoom.
    modifiers: modifiers,
  }

  /// A widget's complete text after a person edited it in a native control.
  ///
  /// Sent by hosts that lower widgets to real OS controls, where the control
  /// holds the authoritative text. The app replaces its own copy with `text`
  /// rather than appending, which is the only way deleting, selecting, and
  /// pasting can be represented faithfully.
  record text-changed-event {
    /// Target window id.
    window: u64,
    /// Widget whose text changed.
    widget: u64,
    /// The control's complete text now.
    text: string,
  }

  /// Keyboard input event delivered by the host.
  record key-event {
    /// Target window id.
    window: u64,
    /// Focused widget id if one exists.
    widget: option<u64>,
    /// Host-normalized key name.
    key: string,
    /// True when this is a key press, false when it is a release.
    pressed: bool,
    /// Modifier state at the time of the event.
    modifiers: modifiers,
  }

  /// Error shape returned by UI calls.
  variant ui-error {
    /// Capability policy or sandbox rules denied the operation.
    permission-denied,
    /// The window id is unknown or closed.
    invalid-window,
    /// The widget id is unknown or belongs to another window.
    invalid-widget,
    /// The host cannot support this UI feature yet.
    unsupported(string),
    /// Host-specific UI error text.
    platform(string),
  }

  /// Widget type in the portable tree.
  enum widget-kind {
    /// Flex-style stack container.
    stack,
    /// Grid container.
    grid,
    /// Scroll container.
    scroll,
    /// Tab container.
    tabs,
    /// Push button.
    button,
    /// Checkbox.
    checkbox,
    /// Radio button.
    radio,
    /// On/off switch.
    switch,
    /// Numeric slider.
    slider,
    /// Progress indicator.
    progress,
    /// Static text.
    text,
    /// Single-line text field.
    text-field,
    /// Multi-line text area.
    text-area,
    /// List view.
    list-view,
    /// Tree view.
    tree-view,
    /// Image view.
    image,
    /// Custom drawing canvas.
    canvas,
    /// A container whose children all fill it and paint in order, back to
    /// front.
    ///
    /// Every other container gives its children a share of the space. This one
    /// gives each of them ALL of it, so a HUD sits over a game, a pause menu
    /// over a board, a caption over a photo. Without it a 3D app could not have
    /// a HUD at all: a canvas holding a scene and a canvas holding an overlay
    /// were laid out one above the other, each getting half the window.
    ///
    /// Appended at the end of this enum on purpose. Every case before it keeps
    /// the number it had, so an app built before this existed still means what
    /// it meant.
    overlay,
  }

  /// Caret and selection inside a text widget, as byte offsets into its label.
  ///
  /// Hosts that paint their own text (Linux, Windows) have no native control to
  /// hold a caret, so an app that implements editing itself reports where the
  /// caret and selection sit and the painter draws them. `cursor` is the caret;
  /// `anchor` is the other end of the selection. Equal offsets mean no
  /// selection, just a caret. Hosts that lower to a real OS control ignore this:
  /// the control owns its own caret.
  record text-cursor {
    /// Caret position as a byte offset into the label, clamped to its length.
    cursor: u32,
    /// The other end of the selection. Equal to `cursor` means no selection.
    anchor: u32,
  }

  /// A colour, as 8-bit channels.
  ///
  /// Bytes rather than floats because a widget colour is picked, not
  /// computed: an app writes 255 or 0x11 and means it. `krate:gfx` uses
  /// floats because a shader multiplies them.
  record color {
    /// Red channel, 0-255.
    r: u8,
    /// Green channel, 0-255.
    g: u8,
    /// Blue channel, 0-255.
    b: u8,
    /// Alpha channel, 0-255. 0 is invisible, 255 is opaque.
    a: u8,
  }

  /// How a label is inked, for text that has to be read over something the
  /// app does not control.
  ///
  /// Every label used to be painted in one near-black at one size, which is
  /// right for a form on a pale panel and wrong the moment the background is
  /// a photograph or a 3D scene. Over a racing game the same fixed colour sat
  /// at 3.98:1 against the sky and 1.27:1 against asphalt -- the second of
  /// those is unreadable, and no single colour fixes both, because the
  /// background changes as the camera turns (K-402).
  ///
  /// The `outline` is what makes that solvable rather than a compromise. A
  /// light glyph with a dark outline reads at roughly 19:1 against its own
  /// outline whatever is behind it, which is why every game HUD and every
  /// subtitle is drawn this way. Where the outline itself disappears -- on
  /// asphalt, in shadow -- the glyph is already high-contrast against that
  /// dark background on its own, so the pair covers both ends.
  record text-style {
    /// Ink colour. Omitted means the host's ordinary label colour, which is
    /// what every existing app gets.
    color: option<color>,
    /// Outline colour, drawn around the glyphs. Omitted means no outline.
    outline: option<color>,
    /// Outline thickness in logical pixels. Clamped by the host to something
    /// it can draw; 1 to 2 is the useful range, and 0 means no outline
    /// however `outline` is set.
    outline-width: f32,
    /// Font size in logical pixels. Omitted means the host's default, which
    /// is 13 -- right for a form and small for a HUD read at speed.
    size: option<f32>,
    /// Draw the label bold.
    bold: bool,
  }

  /// How a widget's BOX is painted: its background, border and corners.
  ///
  /// Every field is optional or zero-defaulted, so a widget that names none of
  /// this looks exactly as it did -- the host's own colours, which is what
  /// every app written before this gets.
  ///
  /// This exists because a container was not painted at all. `stack`, `grid`
  /// and `scroll` drew nothing, and the painted kinds took hard-coded colours
  /// (COLOR_BUTTON, COLOR_FIELD_FILL, COLOR_TRACK), so an app could not give a
  /// card a background or a panel a border. The only way to draw one was to
  /// abandon the widget set for a canvas and hand-draw the whole interface --
  /// which meant giving up real controls, native text editing, host scrolling
  /// and accessibility to get a rounded corner.
  record box-style {
    /// Fill behind the widget's content. Omitted means the host's own
    /// background for that kind, so a button stays the host's button colour.
    background: option<color>,
    /// Border colour. Omitted means no border however `border-width` is set.
    border: option<color>,
    /// Border thickness in logical pixels. Clamped by the host; 0 means no
    /// border however `border` is set.
    border-width: f32,
    /// Corner radius in logical pixels, the same on all four corners.
    ///
    /// One radius rather than four: every use we have seen wants one, and a
    /// host that cannot do per-corner radii would have to refuse or lie about
    /// the other three.
    corner-radius: f32,
  }

  /// Minimal style block for the first widget protocol draft.
  record style {
    /// Optional width in logical pixels.
    width: option<f32>,
    /// Optional height in logical pixels.
    height: option<f32>,
    /// Flex grow factor.
    grow: f32,
    /// Padding in logical pixels.
    padding: f32,
    /// How this widget's label is inked. Omitted everywhere means every
    /// existing app looks exactly as it did.
    text: option<text-style>,
    /// Where this widget sits inside its parent. Omitted means the corner it
    /// has always started from.
    place: option<placement>,
    /// How this widget's box is painted. Omitted everywhere means every
    /// existing app looks exactly as it did.
    box: option<box-style>,
  }

  /// Where a widget sits inside the space its parent gives it.
  ///
  /// Without this, every child of an `overlay` is pinned to the same cell and
  /// starts at its top-left, so the only way to move anything is padding --
  /// and padding changes the PARENT'S SIZE, which in an overlay resizes
  /// everything else sharing that cell. Pushing a prompt to the bottom with
  /// 790 pixels of padding grew the overlay and stretched the scene canvas
  /// past the window (K-410).
  ///
  /// So this is not a styling nicety. It decides whether a countdown digit
  /// can sit in the middle of the screen and a prompt at the foot of it,
  /// which is most of what a HUD is.
  enum placement {
    /// The default: wherever the container would have put it.
    %default,
    top-left,
    top-centre,
    top-right,
    centre-left,
    %centre,
    centre-right,
    bottom-left,
    bottom-centre,
    bottom-right,
  }

  /// One node in the portable widget tree.
  record widget-node {
    /// Stable app-owned widget id.
    id: u64,
    /// Optional parent widget id.
    parent: option<u64>,
    /// Widget kind.
    kind: widget-kind,
    /// User-visible label or text.
    label: option<string>,
    /// Accessibility role hint.
    role: option<string>,
    /// Small layout and sizing block.
    style: style,
    /// On/off state for checkable kinds (checkbox, radio, switch).
    checked: option<bool>,
    /// Normalized 0..=1 value for slider and progress kinds.
    value: option<f32>,
    /// Zero-based index of the selected child, for selectable container
    /// kinds (list-view, tree-view). Out-of-range indices are rejected.
    selected: option<u32>,
    /// Caret and selection for a text widget the app edits itself, drawn by
    /// painting hosts. `none` leaves text caretless, as a passive label.
    text-cursor: option<text-cursor>,
  }

  /// Top-level menu item.
  record menu-item {
    /// Stable command id returned in action events.
    id: u64,
    /// Menu label.
    label: string,
    /// Whether the item can be chosen.
    enabled: bool,
  }

  /// Host event sent to the app.
  /// A file the person handed to the app: a name to show, and a token to open.
  ///
  /// Used by `dialog.open-file`, `dialog.save-file` and the `file-dropped`
  /// event, because all three are the same promise: the person's own act --
  /// a click or a drop -- IS the permission, and the app gets what it needs
  /// to open that one file and nothing that would let it go looking.
  ///
  /// Never a path. The app cannot learn where the file lives, cannot walk to
  /// its folder, and cannot come back for it on a later run.
  record chosen-file {
    /// The file's own name, for showing in the app. Never a path.
    name: string,
    /// An opaque token for this run only. Pass it to `fs.files.open-chosen`.
    token: string,
  }

  variant event {
    /// The user requested that a window close.
    close-requested(u64),
    /// A window was resized.
    resized(window-size),
    /// A window needs redraw.
    redraw-requested(u64),
    /// Pointer input changed.
    pointer(pointer-event),
    /// Keyboard input changed.
    key(key-event),
    /// A wheel turned, or a trackpad scroll gesture moved.
    ///
    /// An app that draws its own content -- anything on a canvas -- keeps its
    /// own scroll offset, adds `dy` to it on each of these, clamps it to the
    /// content it drew, and redraws. Without this event such an app has no way
    /// to reach content past the bottom of its window, no matter how it is
    /// written.
    ///
    /// Apps built from the portable widget tree with a `scroll` container do
    /// not need to handle this: the host scrolls those itself, the way the
    /// platform does, and the event still arrives for anything else on screen.
    wheel(wheel-event),
    /// Text input after keyboard layout or IME processing.
    ///
    /// Append semantics: the characters named here were added to whatever the
    /// app already had. Hosts that draw their own widgets send this.
    text-input(string),
    /// A widget's complete text after the person edited it.
    ///
    /// Replace semantics: the app should set its buffer to exactly this.
    /// Hosts that lower to real OS controls send this instead of `text-input`,
    /// because the control owns the text and edits like deleting, selecting,
    /// and pasting cannot be described as an append.
    text-changed(text-changed-event),
    /// A widget or menu command fired.
    action(u64),
    /// Focus moved to another widget.
    focus-changed(option<u64>),
    /// Host theme changed.
    theme-changed(theme),
    /// The person dropped a file onto the window.
    ///
    /// The drop IS the permission, exactly as the click is for `open-file`:
    /// somebody dragged this file here deliberately, which is a clearer act of
    /// consent than any dialog. So the app gets a name and an opaque token and
    /// never a path -- it cannot learn where the file lives, cannot walk to
    /// its folder, and cannot come back for it on a later run.
    ///
    /// Pass the token to `fs.files.open-chosen`, the same call `open-file`'s
    /// token goes to.
    ///
    /// One event per file: a drop of several files arrives as several of
    /// these, in the order the system reported them, so an app that handles
    /// one file needs no extra code and an app that handles many just keeps
    /// collecting until the queue is empty.
    ///
    /// `ui.dropzone` was declarable, validated by the manifest, worded on the
    /// consent screen ("accept files you drag onto it") and RECOMMENDED by the
    /// port analyzer, with nothing behind it -- an app was told it had the
    /// capability and had no way to receive a drop (K-175).
    file-dropped(chosen-file),
    /// A dragged file is over the window, or has left it again.
    ///
    /// `true` when a drag enters, `false` when it leaves or is cancelled. An
    /// app uses it to show a target -- a highlighted border, a "drop here"
    /// panel -- so the person can see the window will accept what they are
    /// holding. Nothing is revealed about the file: a hover is not consent,
    /// and the app learns only that something is being dragged.
    file-hovering(bool),
  }
}

/// Window lifecycle calls.
interface window {
  use types.{ui-error, window-size, window-state};

  /// Create a host window and return its id.
  create: func(title: string, size: window-size) -> result<u64, ui-error>;
  /// Show a created window.
  show: func(window: u64) -> result<_, ui-error>;
  /// Close a window.
  close: func(window: u64) -> result<_, ui-error>;
  /// Change the title of a window.
  set-title: func(window: u64, title: string) -> result<_, ui-error>;
  /// Change the size of a window.
  set-size: func(window: u64, size: window-size) -> result<_, ui-error>;
  /// Change the state of a window.
  set-state: func(window: u64, state: window-state) -> result<_, ui-error>;
  /// Ask the host to schedule a redraw event.
  request-redraw: func(window: u64) -> result<_, ui-error>;
  /// Extend the app's content into the title-bar area (a full-bleed window).
  ///
  /// The host keeps its own window controls overlaid on top, so the window
  /// can always be closed. On hosts whose windowing cannot do this, the call
  /// returns unsupported and the window keeps its standard chrome -- call it
  /// with `let _ =` and design for both.
  set-full-bleed: func(window: u64, enabled: bool) -> result<_, ui-error>;
}

/// Portable widget tree calls.
interface tree {
  use types.{ui-error, widget-node};

  /// Set or replace the root widget for a window.
  set-root: func(window: u64, root: widget-node) -> result<_, ui-error>;
  /// Insert or update one widget node.
  upsert-node: func(window: u64, node: widget-node) -> result<_, ui-error>;
  /// Remove one widget node and its children.
  remove-node: func(window: u64, widget: u64) -> result<_, ui-error>;
  /// Move keyboard focus to a widget.
  focus-node: func(window: u64, widget: u64) -> result<_, ui-error>;
  /// Enable or disable a widget.
  set-enabled: func(window: u64, widget: u64, enabled: bool) -> result<_, ui-error>;
}

/// Host event delivery calls.
///
/// Events are delivered one at a time in FIFO order. The single-event shape
/// matches the runtime dispatcher's `poll_event` path, and it keeps guest
/// bindings free of list-of-variant lifting, which current guest toolchains
/// cannot compile without dragging WASI panic machinery into otherwise pure
/// components.
/// Pictures for image widgets.
///
/// Deliberately not a field on `widget-node`. The Component Model matches
/// interfaces structurally, so adding a field to that record changes its type
/// and every app already built against the old one stops instantiating --
/// which is the one promise Krate makes about a bundle. A separate interface is
/// additive: an app that shows no pictures never imports this, and its
/// `krate:ui/tree` is exactly the one it was compiled against.
interface image {
  use types.{ui-error};

  /// Decoded picture data.
  ///
  /// Straight RGBA bytes, four per pixel, top row first -- not PNG or JPEG.
  /// An app decodes its own file and sends the result. That is more work for
  /// the app than handing over the file, and it is the point: a decoder for
  /// untrusted image files is one of the most attacked pieces of code there
  /// is, and putting one in the runtime would mean every app's malformed
  /// download runs against the host. Here the decoding happens inside the
  /// sandbox, and what crosses the boundary is pixels, which cannot carry an
  /// exploit for a parser that is no longer in the path.
  record image-pixels {
    /// Width in pixels.
    width: u32,
    /// Height in pixels.
    height: u32,
    /// RGBA bytes, row-major from the top, exactly width * height * 4 long.
    rgba: list<u8>,
  }

  /// Give an image widget its picture. Replaces any picture it already had.
  set-pixels: func(window: u64, widget: u64, pixels: image-pixels) -> result<_, ui-error>;

  /// Take a picture away, leaving an empty frame.
  clear: func(window: u64, widget: u64) -> result<_, ui-error>;
}

/// Host event delivery calls.
///
/// Events are delivered one at a time in FIFO order. The single-event shape
/// matches the runtime dispatcher's `poll_event` path, and it keeps guest
/// bindings free of list-of-variant lifting, which current guest toolchains
/// cannot compile without dragging WASI panic machinery into otherwise pure
/// components.
interface events {
  use types.{event};

  /// Return the next queued event without blocking, if one is waiting.
  poll: func() -> option<event>;
  /// Wait until the next event arrives or the timeout expires.
  wait: func(timeout-millis: option<u32>) -> option<event>;

  /// Whether a key is held down right now.
  ///
  /// A game asks "is W down", not "was W pressed". An app can track this from
  /// press and release events, and every app that tries gets the same bug: the
  /// window loses focus while a key is held, the release is delivered to
  /// somebody else, and the player keeps running forever. The host sees focus
  /// changes and clears held keys on one, so this is the only place the
  /// question can be answered correctly.
  ///
  /// Key names are the same ones `key-event` reports.
  key-held: func(key: string) -> bool;

  /// Whether a gamepad is connected and usable.
  ///
  /// An app should ask before showing "press A to start", and fall back to the
  /// keyboard when this is false rather than leaving somebody staring at a
  /// prompt for a controller they do not own.
  gamepad-connected: func() -> bool;

  /// Whether a gamepad button is held down right now.
  ///
  /// Names are the ones every controller shares regardless of what is printed
  /// on it: `south`, `east`, `west`, `north` for the face buttons, `l1`, `r1`,
  /// `l2`, `r2` for the shoulders, `start`, `select`, and `dpad-up`,
  /// `dpad-down`, `dpad-left`, `dpad-right`.
  ///
  /// Positional rather than lettered because the same physical button is A on
  /// an Xbox pad and B on a Nintendo one. An app that asks for `south` gets
  /// the button under the player's thumb on both.
  gamepad-held: func(button: string) -> bool;

  /// A stick or trigger position, from -1 to 1.
  ///
  /// Axis names: `left-x`, `left-y`, `right-x`, `right-y`, `l2`, `r2`. Up and
  /// right are positive. Triggers report 0 to 1 rather than -1 to 1, because
  /// a trigger has no negative direction and reporting one would mean every
  /// app remapping it.
  ///
  /// Returns 0 when no gamepad is connected, so an app that never checks still
  /// behaves as though the sticks are centred rather than drifting.
  gamepad-axis: func(axis: string) -> f32;
}

/// The mouse, asked about the way a game asks about keys (IC-909).
///
/// Events say what happened. A game wants what is true now: where the
/// pointer is, which buttons are down, how far the mouse moved since the last
/// frame. And a first-person game turns its view with the mouse, which a
/// pointer that stops at the window's edge cannot do -- `capture` holds the
/// pointer, hidden, in the window, and motion keeps coming however far the
/// mouse travels.
///
/// The person can always take the pointer back: Escape, switching to another
/// app, or the window losing focus releases it, and `captured` says so. Like
/// the web's pointer lock, capture asks no permission and works only while the
/// window has focus.
interface pointer {
  use types.{pointer-button, ui-error};

  /// Where the pointer is over the window, in logical pixels from the top-left
  /// of its content, or none when it is outside. It stays put while captured.
  position: func(window: u64) -> option<tuple<f32, f32>>;

  /// Whether a mouse button is held down right now.
  ///
  /// All buttons are released when the window loses focus, so a button can
  /// never stick down the way a key can when its release goes elsewhere.
  button-held: func(button: pointer-button) -> bool;

  /// How far the mouse moved since the last call, in logical pixels, then
  /// zero again. Right and down are positive.
  ///
  /// While captured this is the mouse's own motion, which does not stop at
  /// the edge of the window or the screen.
  take-motion: func(window: u64) -> tuple<f32, f32>;

  /// Hold the pointer in the window: hidden, and turning the view instead of
  /// moving a cursor.
  ///
  /// Refused unless the window has focus. Released by Escape, by focus moving
  /// elsewhere, or by `release`.
  capture: func(window: u64) -> result<_, ui-error>;

  /// Let the pointer go, where it was when it was captured.
  release: func(window: u64);

  /// Whether the pointer is held right now. An app that captured it checks
  /// this to know the person took it back, and shows its menu or a "click to
  /// play" prompt.
  captured: func(window: u64) -> bool;
}

/// What kind of screen a window is on, so an app made once lays itself out
/// for the phone, tablet or desktop it opened on (IC-912).
///
/// Ask on start and again on every `resized` event: a phone turns, a desktop
/// window is narrowed. Lay out from the classes, not from one device's
/// numbers: a compact width is a phone held upright, where panes go in one
/// column and a sidebar becomes tabs or a menu; a compact height is a phone
/// turned sideways, where a tall header costs the whole screen.
interface screen {
  /// How much room there is along one side.
  enum size-class {
    /// A phone: under 600 points wide, or under 500 points tall.
    compact,
    /// A tablet, or a small desktop window.
    medium,
    /// A desktop: 1000 points wide or more, or 900 points tall or more.
    large,
  }

  /// How the person points at things.
  enum input-kind {
    /// A finger: targets at least 44 points, no hover, no right click.
    touch,
    /// A mouse or trackpad: hover and right click exist.
    pointer,
  }

  /// Space at each edge that something else covers: a phone's notch and
  /// home bar, the button Krate draws to close an app on a phone. Keep text
  /// and controls out of it; a background may run underneath.
  record insets {
    /// Points covered along the top edge.
    top: f32,
    /// Points covered along the right edge.
    right: f32,
    /// Points covered along the bottom edge.
    bottom: f32,
    /// Points covered along the left edge.
    left: f32,
  }

  /// One window's screen, now.
  record screen-facts {
    /// The window's width in points: what `canvas-size` answers for a
    /// canvas that fills it.
    width: f32,
    /// The window's height in points.
    height: f32,
    /// The width's class.
    width-class: size-class,
    /// The height's class.
    height-class: size-class,
    /// A finger or a mouse.
    input: input-kind,
    /// The edges to keep text and controls out of.
    safe: insets,
  }

  /// The screen of a window the app owns. A window the app does not own
  /// answers as a desktop window of no size.
  facts: func(window: u64) -> screen-facts;
}

/// The phone tapping back under the finger: a button pressed, a picker's
/// tick, a game's hit (IC-917).
///
/// No permission, as on the phones themselves: any app on screen may tap
/// back. A computer has nothing to tap with, so `available` answers false
/// there and every call does nothing -- call it everywhere, and never make
/// a tap the only sign that something happened.
interface haptics {
  /// What a tap means. The phone plays its own feel for each, the one its
  /// own apps use.
  enum feel {
    /// A light tap: a button pressed, a card set down.
    light,
    /// A firmer tap: a switch flipped, a piece placed.
    medium,
    /// A heavy thud: a landing, a collision.
    heavy,
    /// A tick each time a choice changes: a picker wheel, a slider's step.
    selection,
    /// Something worked: saved, solved, sent.
    success,
    /// Something needs a look.
    warning,
    /// Something failed.
    error,
  }

  /// Whether this device can tap back at all.
  available: func() -> bool;

  /// Tap back now. Taps closer together than the phone can play are
  /// dropped, so a game may call this every frame something is hit.
  play: func(feel: feel);

  /// A game's impact at `strength`, from 0 (barely felt) to 1 (as hard as
  /// the phone can); outside that range is held to it.
  impact: func(strength: f32);
}

/// Which way the phone is held and how it moves: a level, a compass, a game
/// steered by tilting (IC-917).
///
/// Every vector is in the screen's own frame, however the phone is turned:
/// x to the right of the screen, y down it, z out of the glass toward the
/// person. So a game in landscape steers with `gravity.x` exactly as one
/// held upright does. Sensors start on the first `read` and stop when the
/// app closes. A computer has none: `available` is false and `read` none.
interface motion {
  /// Three numbers along the screen's x, y and z.
  record vector {
    /// Along the screen, to the right.
    x: f32,
    /// Along the screen, down.
    y: f32,
    /// Out of the screen, toward the person.
    z: f32,
  }

  /// One reading of the phone's sensors.
  record reading {
    /// Which way is down, in g: (0, 1, 0) held upright, (0, 0, -1) lying
    /// face up on a table. Steer with x; a level is zero in x and y.
    gravity: vector,
    /// The push the person gives the phone, gravity taken out, in g: a
    /// shake, a swing, a step.
    acceleration: vector,
    /// How fast the phone turns, in degrees a second: x above zero tips
    /// the screen's top edge toward the person, y above zero swings its
    /// right edge toward the person, z above zero turns the phone
    /// anticlockwise as the person sees it.
    rotation: vector,
    /// Degrees clockwise from magnetic north that the top of the screen
    /// faces, when the compass knows; none until it settles or without one.
    heading: option<f32>,
  }

  /// Whether this device can tell how it is held.
  available: func() -> bool;

  /// The latest reading, up to sixty a second; none on a device without
  /// sensors, and for the first moment after the first ask.
  read: func() -> option<reading>;
}

/// Where the phone is: a map's dot, a run's distance, a "near me" (IC-917).
///
/// Behind `location.read`, which the person is asked about on Krate's sheet
/// and then by the phone itself. Ask with `current` each time a fix is
/// wanted: the first ask starts the phone looking and answers `finding`;
/// a moment later it answers the position. Reading stops when the app
/// closes.
interface location {
  /// One fix.
  record position {
    /// Degrees north of the equator; south is negative.
    latitude: f64,
    /// Degrees east of Greenwich; west is negative.
    longitude: f64,
    /// How far off the fix may be, in metres: the radius of the circle the
    /// phone is somewhere in.
    accuracy: f32,
    /// Metres above sea level, when the phone knows.
    altitude: option<f32>,
    /// Metres a second, when moving and the phone knows.
    speed: option<f32>,
    /// Degrees clockwise from true north it is heading, when moving.
    course: option<f32>,
    /// How old the fix is, in milliseconds.
    age-ms: u64,
  }

  /// Why there is no position.
  variant location-error {
    /// The person said no, on Krate's sheet or the phone's own prompt, or
    /// the app did not declare `location.read`.
    not-allowed,
    /// This device cannot tell where it is, or location is switched off.
    unavailable,
    /// Still looking: ask again in a moment.
    finding,
  }

  /// Whether this device can tell where it is at all.
  available: func() -> bool;

  /// The latest fix.
  current: func() -> result<position, location-error>;
}

/// A Bluetooth device the person picks: a heart-rate strap, a sensor, a
/// light, a toy (IC-917). Bluetooth Low Energy, its services and
/// characteristics named by their UUIDs ("180D", or the full form).
///
/// Behind `bluetooth.connect`. An app never scans: `choose` shows Krate's
/// own list of nearby devices offering a service, the person taps one, and
/// that one device -- only it, only for this run -- is the app's. The pick
/// is the grant, as with a file.
interface bluetooth {
  /// A device the person picked.
  record device {
    /// The handle to pass to the calls below; good for this run only.
    id: u64,
    /// The name it gives itself, or "Unnamed device".
    name: string,
  }

  /// A value a device sent on its own, after `subscribe`.
  record notification {
    /// The service it came from, as the app named it.
    service: string,
    /// The characteristic that changed, as the app named it.
    characteristic: string,
    /// Its new value.
    data: list<u8>,
  }

  /// Why a Bluetooth call did not work.
  variant bluetooth-error {
    /// The person said no on Krate's sheet or the phone's prompt, or the
    /// app did not declare `bluetooth.connect`.
    not-allowed,
    /// No Bluetooth here, or it is switched off.
    unavailable,
    /// No such device nearby, or the device has no such service or
    /// characteristic.
    not-found,
    /// The device went out of range or was switched off: choose it again.
    disconnected,
    /// The device refused, in its own words.
    failed(string),
  }

  /// Whether this device has Bluetooth at all.
  available: func() -> bool;

  /// Look for nearby devices offering `service`, show them in Krate's own
  /// list under `title` ("Pick your heart-rate monitor"), and connect to
  /// the one the person taps. None when they cancel.
  choose: func(window: u64, service: string, title: string) -> result<option<device>, bluetooth-error>;

  /// Read a characteristic's value once.
  read: func(device: u64, service: string, characteristic: string) -> result<list<u8>, bluetooth-error>;

  /// Write a characteristic's value; `with-response` waits for the device
  /// to say it took it.
  write: func(device: u64, service: string, characteristic: string, data: list<u8>, with-response: bool) -> result<_, bluetooth-error>;

  /// Be sent a characteristic's value each time it changes (a heartbeat,
  /// a reading); collect them with `notifications`.
  subscribe: func(device: u64, service: string, characteristic: string) -> result<_, bluetooth-error>;

  /// Every value sent since the last ask, oldest first.
  notifications: func(device: u64) -> list<notification>;

  /// Whether the device is still connected.
  connected: func(device: u64) -> bool;

  /// Let the device go. Closing the app does this too.
  disconnect: func(device: u64);
}

/// The system's own text entry, for an app that draws its own text fields:
/// a game's name box, an emulator, a canvas editor.
///
/// On a phone or tablet `start` brings up the on-screen keyboard. What is
/// typed arrives exactly as from a physical keyboard: text as `text-input`
/// events, Backspace and Enter as key events. Where a keyboard is always
/// there, `start` does nothing and says so. An app built from the widget
/// tree never needs this: its text fields ask for the keyboard themselves.
interface text-entry {
  /// Ask for text entry in a window the app owns. True when the system is
  /// now showing an on-screen keyboard; false where there is none to show,
  /// which on a desktop means the physical keyboard is the way in.
  start: func(window: u64) -> bool;
  /// Done typing: put the on-screen keyboard away.
  stop: func(window: u64);
}

/// The fingers on a touch screen, asked about the way a game asks about keys.
///
/// A phone has no mouse and many fingers: a game moves with one thumb, aims
/// with the other and fires with a tap, all at once. Taps and scrolls still
/// arrive as pointer and wheel events for ordinary apps; this is for an app
/// that wants every finger, where it is, right now.
interface touch {
  /// One finger on the screen.
  record touch-point {
    /// Stays the same from the moment the finger lands until it lifts, so an
    /// app can follow one thumb while another comes and goes.
    id: u64,
    /// Across the window, in logical pixels from the content's left edge.
    x: f32,
    /// Down the window, in logical pixels from the content's top edge.
    y: f32,
  }

  /// Every finger touching the window now. Empty where there is no touch
  /// screen, and after the window loses focus, so a finger never sticks.
  touches: func(window: u64) -> list<touch-point>;
}

/// System dialog calls.
interface dialog {
  use types.{chosen-file, ui-error};

  /// Show a simple message dialog.
  message: func(window: u64, title: string, body: string) -> result<_, ui-error>;
  /// Ask a yes/no question and return true for yes.
  confirm: func(window: u64, title: string, body: string) -> result<bool, ui-error>;

  /// Ask the person to choose a file, and return what they chose.
  ///
  /// The one grant that is decided while the app runs rather than before it.
  /// Every other capability comes from a list somebody reads first; this one
  /// comes from a click, and the click *is* the grant -- choosing a file in a
  /// native dialog says "this app may have this file" more directly and more
  /// comprehensibly than any manifest line.
  ///
  /// So it returns a name and a token, never a path. The app can open what it
  /// was handed and cannot learn where the file lives, cannot walk to its
  /// folder, and cannot come back for it on a later run. `ui.dialog:file-open`
  /// buys the right to ask; the person's click decides the answer.
  ///
  /// `none` means they cancelled, which is a normal outcome and not an error.

  /// Show the system's open-file dialog.
  ///
  /// `filter` is a comma-separated extension list such as `"png,jpg"`, or an
  /// empty string for any file. It is a hint to the dialog, not a rule the
  /// runtime enforces -- what the person picks is what the app gets.
  open-file: func(window: u64, title: string, filter: string) -> result<option<chosen-file>, ui-error>;

  /// Show the system's save-file dialog, and return where to write.
  ///
  /// The counterpart to `open-file`, and the reason it exists: an editor that
  /// can open a document and not save one is not an editor. `ui.dialog:file-save`
  /// was declarable and consent-worded with nothing behind it -- an app was
  /// told it had the capability and had no function to call (K-393).
  ///
  /// Same grant model as `open-file`, and for the same reason: the person's
  /// click IS the permission. It returns a name and a token, never a path, so
  /// the app can write what it was handed and cannot learn where the file
  /// lives, cannot walk to its folder, and cannot come back for it on a later
  /// run.
  ///
  /// Pass the token to `fs.files.open-chosen` with a writing mode. The token
  /// names a file the person nominated; it does not itself create or truncate
  /// anything, so an app that asks and then does not write leaves nothing
  /// behind.
  ///
  /// `suggested` is the name to show in the dialog -- what the app would call
  /// the file if nobody said otherwise. Empty leaves it to the system.
  ///
  /// `none` means they cancelled, which is a normal outcome and not an error.
  save-file: func(window: u64, title: string, suggested: string, filter: string) -> result<option<chosen-file>, ui-error>;

  /// A folder the person picked; carried by token, never by path.
  record chosen-folder {
    /// The folder's display name, for showing which folder is in use.
    name: string,
    /// Prefix paths with `picked/<token>/` to reach files inside it through
    /// the ordinary fs calls -- list, read, write, mkdir, remove all work
    /// under that prefix, and only there.
    token: string,
  }

  /// Ask the person to choose a folder, and return what they chose.
  ///
  /// This is how an app reaches a real folder of theirs: not by naming a
  /// path (no path can be named), and not by asking for everything, but by
  /// the person picking one -- and the pick IS the grant. The app can then
  /// use every fs call under `picked/<token>/...` for this run: list what
  /// is there, read files, write results, make subfolders. The grant ends
  /// with the run; nothing about the folder's location is learnable; and a
  /// tidy-my-folder app needs exactly this and no fs capability at all.
  ///
  /// `none` means they cancelled, which is a normal outcome and not an
  /// error. Requires the `ui.dialog:open-folder` capability.
  open-folder: func(window: u64, title: string) -> result<option<chosen-folder>, ui-error>;
}

/// Clipboard calls.
interface clipboard {
  use types.{ui-error};

  /// Read UTF-8 text from the host clipboard.
  read-text: func() -> result<string, ui-error>;
  /// Write UTF-8 text to the host clipboard.
  write-text: func(text: string) -> result<_, ui-error>;
}

/// Menu calls.
interface menu {
  use types.{menu-item, ui-error};

  /// Set the simple top-level menu for a window.
  set-items: func(window: u64, items: list<menu-item>) -> result<_, ui-error>;
}

/// Opening a link in the person's browser.
///
/// An app that shows documentation, a sign-in page, or a "learn more" link
/// needs this, and without it the only alternative is a process capability --
/// which is far broader authority than opening a URL.
///
/// This hands a URL to the operating system's own handler. The app cannot
/// choose which program runs, cannot pass arguments to it, and cannot read
/// anything back, so this stays a request to the system rather than a way to
/// execute something. Schemes are restricted to `https` and `mailto`: `file://`
/// would read the user's disk through the browser, and a custom scheme can
/// launch another installed application with attacker-chosen text.
interface launcher {
  /// Why a URL could not be opened.
  variant launch-error {
    /// The app did not receive the `ui.open-url` capability.
    denied,
    /// The URL was malformed, or used a scheme this interface does not allow.
    invalid-url(string),
    /// The operating system refused or had no handler for it.
    unavailable(string),
  }

  /// Ask the operating system to open a URL in whatever the person uses.
  ///
  /// Returns once the request is handed over, not when the page has loaded:
  /// the app gets no signal about what the browser then did, which is what
  /// keeps this from becoming a channel back into the app.
  open-url: func(url: string) -> result<_, launch-error>;
}

/// The person's photo library: pick photos from it, add a picture to it
/// (IC-920).
///
/// Picking shows the system's own photo picker; the photos picked come back
/// as files to read with `fs.files.open-chosen`, and the pick is the grant,
/// as with `dialog.open-file` -- the app never sees the rest of the
/// library. Adding is behind `photos.add`, and the phone asks too, for
/// add-only access: the app can add, never look.
interface photos {
  use types.{chosen-file};

  /// Why a photos call did not work.
  variant photos-error {
    /// The app did not declare `photos.add`, or the person said no.
    not-allowed,
    /// No photo library here, or it would not answer.
    unavailable(string),
    /// The picture's bytes are not a PNG or a JPEG, or are over 64 MB.
    invalid(string),
  }

  /// Show the photo picker for up to `limit` photos (1 to 20). The photos
  /// picked, as JPEG files; empty when the person cancelled. On a computer,
  /// the system's file picker for pictures.
  pick: func(window: u64, limit: u32) -> result<list<chosen-file>, photos-error>;

  /// Add a picture -- PNG or JPEG bytes -- to the photo library.
  save: func(window: u64, data: list<u8>) -> result<_, photos-error>;
}

/// Hand something to another app: a note to Messages, a picture to Photos
/// or AirDrop, a file to Mail (IC-919).
///
/// The system's own share sheet opens with what the app gives it, and the
/// person picks where it goes -- or cancels. The pick is the grant, so no
/// capability: the app gives only what it already holds, and learns only
/// whether it was sent.
interface share {
  /// A file to share: its name and its bytes.
  record shared-file {
    /// The name the other app sees ("sketch.png"), extension included.
    name: string,
    /// The file's bytes.
    data: list<u8>,
  }

  /// Why the sheet did not open.
  variant share-error {
    /// This device has no share sheet (computers, for now).
    unavailable(string),
    /// Nothing to share, a name with a path in it, or more than 64 MB.
    invalid(string),
  }

  /// Open the share sheet with any of a text, a link and files. True when
  /// the person sent it somewhere, false when they cancelled.
  share: func(window: u64, text: option<string>, url: option<string>, files: list<shared-file>) -> result<bool, share-error>;
}

/// Signing the person in to a service the app talks to (IC-923): GitHub,
/// Google, the developer's own backend.
///
/// OAuth 2 with PKCE, through the platform's own sign-in sheet
/// (ASWebAuthenticationSession on a Mac and an iPhone). The person types
/// their password into the service's real page in the system browser,
/// never into the app; the app only learns the address the service sends
/// them back to, which carries the one-time code. It then trades that code
/// for a token with an ordinary fetch to the service's token address
/// (`net.connect` to that host), sending the PKCE verifier, and keeps the
/// token in `store.secret`.
interface sign-in {
  /// Why there is no code.
  variant sign-in-error {
    /// The person closed the sheet.
    cancelled,
    /// This device has no sign-in sheet (computers other than a Mac, for
    /// now), or it would not open.
    unavailable(string),
    /// The address is not https, or the callback scheme is not one an app
    /// may use.
    invalid(string),
  }

  /// A fresh PKCE pair: the verifier the app keeps for the token request,
  /// and its S256 challenge for the authorize address
  /// (`code_challenge=...&code_challenge_method=S256`).
  pkce: func() -> tuple<string, string>;

  /// Open the sign-in sheet at `authorize-url` (https, carrying the app's
  /// client id, its redirect address, a `state` and the PKCE challenge)
  /// and wait for the service to send the person back to an address that
  /// starts with `callback-scheme:` -- the one registered with the service
  /// ("myapp" for `myapp://signed-in`). Returns that whole address: read
  /// `code` from it, and check its `state` is the one you sent.
  start: func(window: u64, authorize-url: string, callback-scheme: string) -> result<string, sign-in-error>;
}

/// Asking the person to prove it is them before the app shows something
/// private (IC-924): Face ID or the passcode on an iPhone, Touch ID or the
/// password on a Mac.
///
/// The check is the system's own; the app never sees a face, a finger or a
/// passcode, only whether the person passed. Use it in front of what
/// `store.secret` keeps: unlock the vault, then read it.
interface unlock {
  /// How the check went.
  variant unlock-answer {
    /// It is them.
    yes,
    /// They cancelled or failed it: keep it locked.
    no,
    /// This device cannot check (no passcode set, no biometrics, a
    /// computer without them), and why. Offer the app's own way or say so.
    unavailable(string),
  }

  /// Whether this device can check it is the person.
  available: func() -> bool;

  /// Ask, with the app's reason in the system's own sheet ("Unlock your
  /// vault"). Waits while the person looks or types their passcode.
  check: func(reason: string) -> unlock-answer;
}

/// Desktop notifications.
///
/// An app that finishes a long task, receives a message, or hits a timer needs
/// to say so when its window is not in front. Without it, an app can only speak
/// while the person is already looking at it.
interface notify {
  /// Why a notification could not be shown.
  variant notify-error {
    /// The app did not receive the `ui.notify` capability.
    denied,
    /// The title or body was empty or longer than the host allows.
    invalid-content(string),
    /// The operating system has no notification service available.
    unavailable(string),
  }

  /// Show one notification.
  ///
  /// The host attributes it to the app, so an app cannot post a notification
  /// that appears to come from somewhere else. There is no reply channel: an
  /// app learns nothing about whether the notification was seen or clicked,
  /// which keeps this from becoming a way to watch the person.
  show: func(title: string, body: string) -> result<_, notify-error>;
}

/// Reminders that arrive when the app is closed: a timer that rings, a
/// habit nudged each evening, a meeting about to start (IC-921).
///
/// Behind `ui.notify`, and the phone asks the person once. The system
/// delivers them; tapping one opens the app that set it. Each app sees and
/// cancels only its own.
interface reminders {
  use notify.{notify-error};

  /// Set reminder `id` (letters, digits, `-` and `_`, up to 64) to arrive
  /// `after-seconds` from now (1 second to a year), replacing one with the
  /// same id. With `daily`, it comes back at that time of day every day.
  schedule: func(id: string, title: string, body: string, after-seconds: u64, daily: bool) -> result<_, notify-error>;

  /// Take back a reminder not yet delivered. Unknown ids are ignored.
  cancel: func(id: string);

  /// The ids of this app's reminders still to come.
  pending: func() -> list<string>;
}

/// Printing what the app's window shows.
///
/// The host paints the window for paper and the system's print dialog does
/// the rest: the person picks the printer, the copies, or Save as PDF -- or
/// cancels. Nothing prints unless they say so, so any app with a window may
/// ask. Where Krate cannot reach a print dialog, the pages open in the PDF
/// viewer to print from there, and the answer says so.
interface print {
  use types.{ui-error};

  /// What happened.
  enum print-outcome {
    /// The person printed or saved it.
    printed,
    /// They closed the dialog without printing.
    cancelled,
    /// The pages opened in the system's PDF viewer, to print from there.
    opened-in-viewer,
  }

  /// Print what the window shows now, as one page, and wait for the person.
  window: func(window: u64, title: string) -> result<print-outcome, ui-error>;

  /// Keep what the window shows now as the next page of a longer document,
  /// and return how many pages are kept (at most 100). Draw each page in
  /// the window, add it, then `finish`.
  add-page: func(window: u64) -> result<u32, ui-error>;

  /// Print the pages added so far, wait for the person, and start over.
  finish: func(window: u64, title: string) -> result<print-outcome, ui-error>;
}
