<?xml version="1.0" encoding="utf-8"?>
<!-- The Krate player is native code: its activity is a NativeActivity
     that loads libkrate_player.so and calls android_main. KrateActivity
     (android/java) adds only what Android tells an activity alone, such as
     what the person picked in the system's file picker, so hasCode is true
     for that one small classes.dex. extractNativeLibs=true keeps the packaging
     a plain zip without page-alignment ceremony. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tech.krate.player"
    android:versionCode="1"
    android:versionName="0.1.8">

  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

  <!-- Fetching a tapped krate.tech link, and apps' own granted net.fetch
       calls, both go through the network. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- krate:ui/haptics: the phone tapping back under the finger. Granted at
       install; there is no prompt, as for any app's touch feedback. -->
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- krate:ui/location, for an app the person allowed location.read on
       Krate's sheet; the phone asks too, the first time such an app asks. -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <!-- krate:ui/bluetooth, for an app the person allowed bluetooth.connect:
       Krate looks for devices only to list them for the person, never to
       place them, so the scan says neverForLocation. Before Android 12 a
       scan needs location instead (above). -->
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
      android:usesPermissionFlags="neverForLocation" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
  <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
  <!-- IC-918, each for an app the person allowed it on Krate's sheet; the
       phone asks too, the first time such an app uses it. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- krate:ui/photos save, for an app allowed photos.add: from Android 10
       adding to Pictures needs no permission; before, it needs this. -->
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
      android:maxSdkVersion="28" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-feature android:name="android.hardware.microphone" android:required="false" />
  <!-- Which apps open a link, and which voices speak: Android 11 and up
       show an app only what it says it looks for. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <category android:name="android.intent.category.BROWSABLE" />
      <data android:scheme="https" />
    </intent>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
  </queries>

  <application
      android:label="Krate"
      android:hasCode="true"
      android:extractNativeLibs="true">
    <activity
        android:name="tech.krate.player.KrateActivity"
        android:exported="true"
        android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
      <meta-data android:name="android.app.lib_name" android:value="krate_player" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- A shared app link: https://hub.krate.tech/a/<hash> runs the app
           directly. Without assetlinks verification Android offers a
           chooser next to the browser; that is the honest default until a
           release signing certificate exists to pin. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="https" android:host="hub.krate.tech" android:pathPrefix="/a/" />
      </intent-filter>
      <!-- A .krate file from Files, a share sheet, or a download. Content
           resolvers usually report octet-stream and often drop the
           extension, so both shapes are claimed. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="content" android:mimeType="application/octet-stream" />
        <data android:scheme="file" android:mimeType="application/octet-stream" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.krate" />
        <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.krate" />
      </intent-filter>
    </activity>
    <!-- Files an app shares (krate:ui/share), read-only, to the one app the
         person picked in the share sheet. -->
    <provider
        android:name="tech.krate.player.Shared"
        android:authorities="tech.krate.player.share"
        android:exported="false"
        android:grantUriPermissions="true" />
  </application>
</manifest>
